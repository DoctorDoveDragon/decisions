def create_cosmic_visualization():
    """Create a cosmic-themed visualization"""
    # Generate cosmic data
    theta = np.linspace(0, 2*np.pi, 100)
    r = np.random.rand(100) * 10
    
    fig = go.Figure()
    
    # Add cosmic spiral
    fig.add_trace(go.Scatterpolar(
        r=r,
        theta=theta,
        mode='lines',
        line=dict(color='#40e0d0', width=3),
        name='Cosmic Flow'
    ))
    
    # Add decision nodes
    for i in range(8):
        angle = i * np.pi/4
        fig.add_trace(go.Scatterpolar(
            r=[r[i*12]],
            theta=[theta[i*12]],
            mode='markers+text',
            marker=dict(size=20, color='#3b82f6'),
            text=[f'D{i+1}'],
            textposition="middle center",
            name=f'Decision Node {i+1}'
        ))
    
    fig.update_layout(
        polar=dict(
            bgcolor='rgba(10, 14, 23, 0.8)',
            radialaxis=dict(visible=False),
            angularaxis=dict(visible=False)
        ),
        showlegend=False,
        height=400,
        paper_bgcolor='rgba(0,0,0,0)',
        plot_bgcolor='rgba(0,0,0,0)',
        margin=dict(t=0, b=0, l=0, r=0)
    )
    
    return fig

